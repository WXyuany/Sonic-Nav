        "grasp_affordance": "single_hand_pinch",
        "missing_skills": [],
        "unready_count": 0
      }
    },
    {
      "name": "vlm_pick_box",
      "request": {
        "action": "grasp",
        "object": "demo_box",
        "id": "vlm-pick-box"
      },
      "expect": {
        "steps": [
          "navigate.approach_object",
          "manip.align_workspace",
          "manip.bimanual_clamp",
