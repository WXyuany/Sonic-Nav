<mujoco model="g1_box_demo">
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0 0 0.5" extent="8.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.6 0.6 0.65 1"/>
    <material name="table_mat" rgba="0.50 0.34 0.20 1"/>
    <material name="table_edge_mat" rgba="0.30 0.20 0.12 1"/>
    <material name="box_mat" rgba="0.85 0.58 0.28 1"/>
    <material name="box_tape_mat" rgba="0.42 0.25 0.10 1"/>
    <material name="guide_mat" rgba="0.15 0.75 0.95 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <geom name="wall_north" type="box" size="4.0 0.05 1.0" pos="0 4.0 1.0" material="wall_mat"/>
    <geom name="wall_south" type="box" size="4.0 0.05 1.0" pos="0 -4.0 1.0" material="wall_mat"/>
    <geom name="wall_east" type="box" size="0.05 4.0 1.0" pos="4.0 0 1.0" material="wall_mat"/>
    <geom name="wall_west" type="box" size="0.05 4.0 1.0" pos="-4.0 0 1.0" material="wall_mat"/>

    <site name="walk_target_strip" type="box" size="0.02 0.55 0.006" pos="1.22 0 0.012" material="guide_mat"/>

    <geom name="demo_table_top" type="box" size="0.46 0.42 0.035" pos="1.90 0 0.64" material="table_mat"
      friction="1.4 0.08 0.01"/>
    <geom name="demo_table_front_edge" type="box" size="0.47 0.02 0.055" pos="1.90 -0.42 0.61" material="table_edge_mat"/>
    <geom name="demo_table_back_edge" type="box" size="0.47 0.02 0.055" pos="1.90 0.42 0.61" material="table_edge_mat"/>
    <geom name="demo_table_leg_fl" type="cylinder" size="0.025 0.31" pos="1.52 -0.33 0.31" material="table_mat"/>
    <geom name="demo_table_leg_fr" type="cylinder" size="0.025 0.31" pos="2.28 -0.33 0.31" material="table_mat"/>
    <geom name="demo_table_leg_bl" type="cylinder" size="0.025 0.31" pos="1.52 0.33 0.31" material="table_mat"/>
    <geom name="demo_table_leg_br" type="cylinder" size="0.025 0.31" pos="2.28 0.33 0.31" material="table_mat"/>

    <body name="demo_box" pos="1.64 0 0.775">
      <freejoint name="demo_box_freejoint"/>
      <inertial pos="0 0 0" mass="0.018" diaginertia="0.000114 0.000146 0.000141"/>
      <geom name="demo_box_visual" type="box" size="0.12 0.095 0.10" material="box_mat"
        condim="6" friction="3.2 0.18 0.02" solref="0.01 1" solimp="0.95 0.99 0.001"/>
      <geom name="demo_box_tape_top" type="box" size="0.123 0.010 0.002" pos="0 0 0.102" material="box_tape_mat"
        contype="0" conaffinity="0" group="1"/>
      <geom name="demo_box_tape_front" type="box" size="0.123 0.002 0.024" pos="0 -0.097 0.036" material="box_tape_mat"
        contype="0" conaffinity="0" group="1"/>
    </body>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
