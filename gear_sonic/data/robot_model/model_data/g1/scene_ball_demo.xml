<mujoco model="g1_ball_demo">
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0 0 0.5" extent="8.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.6 0.6 0.65 1"/>
    <material name="table_mat" rgba="0.50 0.34 0.20 1"/>
    <material name="table_edge_mat" rgba="0.30 0.20 0.12 1"/>
    <material name="ball_mat" rgba="0.15 0.55 0.95 1"/>
    <material name="target_mat" rgba="0.15 0.90 0.35 0.35"/>
    <material name="guide_mat" rgba="0.15 0.75 0.95 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <geom name="wall_north" type="box" size="4.0 0.05 1.0" pos="0 4.0 1.0" material="wall_mat"/>
    <geom name="wall_south" type="box" size="4.0 0.05 1.0" pos="0 -4.0 1.0" material="wall_mat"/>
    <geom name="wall_east" type="box" size="0.05 4.0 1.0" pos="4.0 0 1.0" material="wall_mat"/>
    <geom name="wall_west" type="box" size="0.05 4.0 1.0" pos="-4.0 0 1.0" material="wall_mat"/>

    <site name="walk_target_strip" type="box" size="0.02 0.55 0.006" pos="1.16 0 0.012" material="guide_mat"/>

    <geom name="demo_table_top" type="box" size="0.48 0.42 0.035" pos="1.90 0 0.76" material="table_mat"
      condim="6" friction="1.5 0.10 0.01" solref="0.003 1" solimp="0.99 0.999 0.0001"/>
    <geom name="demo_table_front_edge" type="box" size="0.49 0.02 0.055" pos="1.90 -0.42 0.73"
      material="table_edge_mat" contype="0" conaffinity="0" group="1" density="0"/>
    <geom name="demo_table_back_edge" type="box" size="0.49 0.02 0.055" pos="1.90 0.42 0.73"
      material="table_edge_mat" contype="0" conaffinity="0" group="1" density="0"/>
    <geom name="demo_table_leg_fl" type="cylinder" size="0.025 0.37" pos="1.52 -0.33 0.37" material="table_mat"/>
    <geom name="demo_table_leg_fr" type="cylinder" size="0.025 0.37" pos="2.28 -0.33 0.37" material="table_mat"/>
    <geom name="demo_table_leg_bl" type="cylinder" size="0.025 0.37" pos="1.52 0.33 0.37" material="table_mat"/>
    <geom name="demo_table_leg_br" type="cylinder" size="0.025 0.37" pos="2.28 0.33 0.37" material="table_mat"/>

    <site name="demo_ball_place_target" type="cylinder" size="0.095 0.003" pos="1.62 -0.08 0.799" material="target_mat"/>

    <body name="demo_ball" pos="1.62 -0.28 0.840">
      <freejoint name="demo_ball_freejoint"/>
      <inertial pos="0 0 0" mass="0.003" diaginertia="0.000001 0.000001 0.000001"/>
      <geom name="demo_ball_visual" type="sphere" size="0.045" material="ball_mat"
        condim="6" friction="8.0 0.60 0.08" solref="0.003 1" solimp="0.99 0.999 0.0001"/>
    </body>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
