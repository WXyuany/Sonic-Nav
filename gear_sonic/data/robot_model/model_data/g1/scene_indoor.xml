      <geom name="kitchen_island_collision" type="box" size="0.92 0.48 0.47" pos="0 0 0.47" material="cabinet_mat"/>
      <site name="island_countertop" type="box" size="0.94 0.50 0.04" pos="0 0 0.94" material="countertop_mat"/>
      <site name="island_bowl" type="sphere" size="0.13" pos="-0.38 -0.12 1.03" material="warning_mat"/>
      <site name="island_cutting_board" type="box" size="0.23 0.15 0.012" pos="0.25 0.05 1.005" material="desk_mat"/>
    </body>

    <!-- Dining area on the west side, clear of the robot start lane. -->
    <site name="dining_rug" type="box" size="2.15 1.45 0.01" pos="-3.45 -0.10 0.012" material="carpet_mat"/>
    <body name="dining_table" pos="-3.45 -0.10 0">
