    <geom name="planter_pot" type="cylinder" size="0.18 0.22" pos="-5.20 3.45 0.22" material="cabinet_mat"/>
    <site name="planter_leaf_1" type="ellipsoid" size="0.10 0.04 0.22" pos="-5.27 3.45 0.55" euler="0.4 0.1 0.8" material="plant_mat"/>
    <site name="planter_leaf_2" type="ellipsoid" size="0.10 0.04 0.24" pos="-5.13 3.47 0.58" euler="-0.3 0.2 -0.7" material="plant_mat"/>
