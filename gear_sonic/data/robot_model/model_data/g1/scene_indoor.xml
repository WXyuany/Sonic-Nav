<mujoco model="g1_indoor_navigation">
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0 0 0.7" extent="12.0"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.12 0.14 0.16 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.86 0.92" rgb2="0.08 0.10 0.12" width="512" height="3072"/>
    <texture type="2d" name="floor_tile" file="textures/polyhaven_interior_tiles_diff_1k.png"/>
    <texture type="2d" name="painted_plaster" file="textures/polyhaven_painted_plaster_wall_diff_1k.png"/>
    <texture type="2d" name="real_wood" file="textures/polyhaven_raw_plank_wall_diff_1k.png"/>
    <texture type="2d" name="armchair_fabric" file="textures/polyhaven_armchair_01_diff_1k.png"/>
    <texture type="2d" name="carpet_tile" builtin="checker" mark="none" rgb1="0.22 0.30 0.34" rgb2="0.28 0.38 0.42" width="256" height="256"/>

    <mesh name="armchair_01_visual" file="indoor/armchair_01/armchair_01_visual.obj"/>
    <mesh name="kitchen_cabinet_visual" file="indoor/kitchen_cabinet_visual.obj"/>
    <mesh name="kitchen_island_visual" file="indoor/kitchen_island_visual.obj"/>
    <mesh name="dining_table_visual" file="indoor/dining_table_visual.obj"/>
    <mesh name="dining_chair_visual" file="indoor/dining_chair_visual.obj"/>
    <mesh name="sofa_visual" file="indoor/sofa_visual.obj"/>

    <material name="floor_mat" texture="floor_tile" texuniform="true" texrepeat="6 5" reflectance="0.10"/>
    <material name="carpet_mat" texture="carpet_tile" texuniform="true" texrepeat="4 3" reflectance="0.04"/>
    <material name="wall_mat" texture="painted_plaster" texuniform="true" texrepeat="3 2" rgba="0.92 0.90 0.84 1" reflectance="0.04"/>
    <material name="accent_wall_mat" rgba="0.36 0.49 0.53 1"/>
    <material name="box_mat" rgba="0.42 0.28 0.16 1"/>
    <material name="glass_mat" rgba="0.50 0.72 0.82 0.35"/>
    <material name="trim_mat" rgba="0.88 0.86 0.80 1"/>
    <material name="light_panel_mat" rgba="1.00 0.96 0.78 1" emission="0.45"/>
    <material name="screen_mat" rgba="0.03 0.05 0.07 1" emission="0.10"/>
    <material name="screen_glow_mat" rgba="0.10 0.32 0.56 1" emission="0.35"/>
    <material name="paper_mat" rgba="0.92 0.90 0.82 1"/>
    <material name="book_blue_mat" rgba="0.10 0.20 0.44 1"/>
    <material name="book_red_mat" rgba="0.50 0.12 0.10 1"/>
    <material name="fabric_mat" rgba="0.20 0.24 0.28 1"/>
    <material name="armchair_mesh_mat" texture="armchair_fabric" texuniform="true" reflectance="0.08"/>
    <material name="desk_mat" texture="real_wood" texuniform="true" texrepeat="2 1" reflectance="0.08"/>
    <material name="metal_mat" rgba="0.40 0.42 0.43 1" reflectance="0.18"/>
    <material name="chair_mat" rgba="0.10 0.13 0.16 1"/>
    <material name="cabinet_mat" rgba="0.25 0.28 0.30 1"/>
    <material name="countertop_mat" rgba="0.68 0.66 0.60 1" reflectance="0.14"/>
    <material name="appliance_mat" rgba="0.72 0.75 0.75 1" reflectance="0.22"/>
    <material name="plant_mat" rgba="0.12 0.42 0.18 1"/>
    <material name="warning_mat" rgba="0.95 0.65 0.16 1"/>
  </asset>

  <worldbody>
    <light name="ceiling_key" pos="0 0 5.5" dir="0 0 -1" directional="true" diffuse="0.55 0.55 0.52"/>
    <light name="kitchen_light" pos="0 3.4 2.8" dir="0 0 -1" diffuse="0.42 0.40 0.36"/>
    <light name="dining_light" pos="-3.4 -0.3 2.6" dir="0 0 -1" diffuse="0.36 0.34 0.30"/>
    <light name="living_light" pos="3.8 -0.7 2.7" dir="0 0 -1" diffuse="0.34 0.34 0.32"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat" friction="1.1 0.02 0.001"/>
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <!-- Outer shell: 12m x 10m open apartment room. -->
    <geom name="wall_north" type="box" size="6.0 0.06 1.25" pos="0 5.0 1.25" material="wall_mat"/>
    <geom name="wall_south" type="box" size="6.0 0.06 1.25" pos="0 -5.0 1.25" material="wall_mat"/>
    <geom name="wall_east" type="box" size="0.06 5.0 1.25" pos="6.0 0 1.25" material="wall_mat"/>
    <geom name="wall_west" type="box" size="0.06 5.0 1.25" pos="-6.0 0 1.25" material="wall_mat"/>
    <site name="baseboard_north" type="box" size="5.85 0.025 0.055" pos="0 4.925 0.12" material="trim_mat"/>
    <site name="baseboard_south" type="box" size="5.85 0.025 0.055" pos="0 -4.925 0.12" material="trim_mat"/>
