    <site name="kitchen_floor_zone" type="box" size="5.35 1.15 0.01" pos="0 3.58 0.012" material="carpet_mat"/>
    <body name="kitchen_base_left" pos="-2.30 4.44 0" euler="0 0 3.1416">
      <geom name="kitchen_base_left_visual" type="mesh" mesh="kitchen_cabinet_visual" material="cabinet_mat" contype="0" conaffinity="0" group="1" density="0"/>
