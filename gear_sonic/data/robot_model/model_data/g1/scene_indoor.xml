    <site name="coffee_table_book" type="box" size="0.20 0.14 0.010" pos="3.35 -1.12 0.55" material="paper_mat"/>
    <geom name="media_console_collision" type="box" size="0.32 1.15 0.33" pos="5.55 -1.05 0.33" material="cabinet_mat"/>
    <site name="tv_panel" type="box" size="0.035 0.88 0.52" pos="5.18 -1.05 1.22" material="screen_mat"/>
