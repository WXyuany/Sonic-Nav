<mujoco model="g1_stairs">
  <include file="g1_29dof_with_hand.xml"/>
  <statistic center="0 0 0.5" extent="10.0"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.2"/>
    <material name="stair" rgba="0.5 0.5 0.55 1"/>
    <material name="ramp" rgba="0.6 0.55 0.5 1"/>
    <material name="wall" rgba="0.6 0.6 0.65 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 8" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <!-- 缓坡 -->
    <geom name="ramp" type="box" size="1.5 4 0.02" pos="-8 0 0.05" euler="0 0 0.35" material="ramp"/>

    <!-- 10级阶梯，每级高12cm深25cm -->
    <body name="stairs" pos="3 0 0">
      <geom name="s0" type="box" size="2 0.12 0.06" pos="0 0 0.06" material="stair"/>
      <geom name="s1" type="box" size="2 0.25 0.06" pos="0.25 0 0.18" material="stair"/>
      <geom name="s2" type="box" size="2 0.25 0.06" pos="0.50 0 0.30" material="stair"/>
      <geom name="s3" type="box" size="2 0.25 0.06" pos="0.75 0 0.42" material="stair"/>
      <geom name="s4" type="box" size="2 0.25 0.06" pos="1.00 0 0.54" material="stair"/>
      <geom name="s5" type="box" size="2 0.25 0.06" pos="1.25 0 0.66" material="stair"/>
      <geom name="s6" type="box" size="2 0.25 0.06" pos="1.50 0 0.78" material="stair"/>
      <geom name="s7" type="box" size="2 0.25 0.06" pos="1.75 0 0.90" material="stair"/>
      <geom name="s8" type="box" size="2 0.25 0.06" pos="2.00 0 1.02" material="stair"/>
      <geom name="s9" type="box" size="2 0.25 0.06" pos="2.25 0 1.14" material="stair"/>
      <!-- 平台 -->
      <geom name="platform" type="box" size="2 1.5 0.06" pos="3.5 0 1.20" material="stair"/>
    </body>

    <!-- 房间墙壁 -->
    <geom name="wall_n" type="box" size="10 0.05 1.0" pos="0 8 1.0" material="wall"/>
    <geom name="wall_e" type="box" size="0.05 8 1.0" pos="10 0 1.0" material="wall"/>
  </worldbody>
  <default><geom friction="1.0"/></default>
</mujoco>
