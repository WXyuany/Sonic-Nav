<mujoco model="g1_dynamic">
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0 0 0.5" extent="8.0"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.6 0.6 0.65 1"/>
    <material name="obs_static" rgba="0.85 0.45 0.25 1"/>
    <material name="obs_dynamic" rgba="0.9 0.2 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <!-- Room walls: 10m x 10m -->
    <geom name="wall_n" type="box" size="5 0.05 1.0" pos="0 5 1.0" material="wall_mat"/>
    <geom name="wall_s" type="box" size="5 0.05 1.0" pos="0 -5 1.0" material="wall_mat"/>
    <geom name="wall_e" type="box" size="0.05 5 1.0" pos="5 0 1.0" material="wall_mat"/>
    <geom name="wall_w" type="box" size="0.05 5 1.0" pos="-5 0 1.0" material="wall_mat"/>

    <!-- Static obstacles -->
    <geom name="s1" type="cylinder" size="0.2 1.0" pos="2 1.5 1.0" material="obs_static"/>
    <geom name="s2" type="cylinder" size="0.25 1.0" pos="-2.5 -1 1.0" material="obs_static"/>
    <geom name="s3" type="box" size="0.3 0.3 0.5" pos="3 -2 0.5" material="obs_static"/>

    <!-- Moving obstacle 1: sliding cylinder on x-axis rail -->
    <body name="rail1" pos="-1.5 3 0">
      <joint name="rail1_j" type="slide" axis="1 0 0" range="-3 3"/>
      <geom name="dyn1" type="cylinder" size="0.2 1.0" pos="0 0 1.0" material="obs_dynamic"/>
    </body>

    <!-- Moving obstacle 2: sliding box on y-axis rail -->
    <body name="rail2" pos="3 -3 0">
      <joint name="rail2_j" type="slide" axis="0 1 0" range="-3 3"/>
      <geom name="dyn2" type="box" size="0.25 0.25 1.0" pos="0 0 1.0" material="obs_dynamic"/>
    </body>

    <!-- Moving obstacle 3: rotating cross bar -->
    <body name="rotor" pos="0 3 0">
      <joint name="rotor_j" type="hinge" axis="0 0 1"/>
      <geom name="dyn3a" type="box" size="1.5 0.1 1.0" pos="0 0 1.0" material="obs_dynamic"/>
      <geom name="dyn3b" type="box" size="0.1 1.5 1.0" pos="0 0 1.0" material="obs_dynamic"/>
    </body>
  </worldbody>

  <actuator>
    <position name="a1" joint="rail1_j" kp="50"/>
    <position name="a2" joint="rail2_j" kp="50"/>
    <velocity name="a3" joint="rotor_j" kv="10"/>
  </actuator>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
